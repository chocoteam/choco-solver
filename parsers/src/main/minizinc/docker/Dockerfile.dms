#------------------------------------------------------------------------------#
# Choco Solver for MiniZinc Challenge - Multi-stage build
# Stage 1: Prepare Choco files with dependencies
# Stage 2: Runtime image with minimal footprint
#------------------------------------------------------------------------------#

# Stage 1: Build/Prepare stage - gather Choco files
FROM minizinc/mznc2026:latest AS builder

# Extra arguments appended to fzn-choco.py invocation (e.g. "-lcg")
ARG EXTRA_FZN_ARGS=""

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-25-jre-headless \
    python3 \
    vim \
    && rm -rf /var/lib/apt/lists/*

COPY ./parsers/target/choco-solver-*-light.jar /choco/choco.jar
COPY ./parsers/src/main/minizinc/fzn-choco.py /choco/fzn-choco.py
COPY ./parsers/src/main/minizinc/fzn-choco.sh /choco/fzn-choco.sh
COPY ./parsers/src/main/minizinc/choco.msc /choco/choco.msc
COPY ./parsers/src/main/minizinc/mzn_lib/* /choco/mzn-lib/

RUN sed -i 's&JAR_FILE=.*&JAR_FILE="/choco/choco.jar"&g' /choco/fzn-choco.py && \
    sed -i 's&"mznlib".*&"mznlib":"/choco/mzn-lib/",&g' /choco/choco.msc && \
    sed -i 's&"executable".*&"executable":"/choco/fzn-choco.sh",&g' /choco/choco.msc && \
    mkdir -p /root/.minizinc && \
    echo '{"mzn_solver_path": ["/choco"],' > /root/.minizinc/Preferences.json && \
    echo '"tagDefaults": [["", "org.choco.choco"]]}' >> /root/.minizinc/Preferences.json && \
    chmod +x /choco/fzn-choco.sh && \
    if [ -n "$EXTRA_FZN_ARGS" ]; then \
      echo '#!/bin/bash' > /choco/fzn-choco.sh && \
      echo 'python3 "$(dirname "$0")/fzn-choco.py" "$@" "'"$EXTRA_FZN_ARGS"'"' >> /choco/fzn-choco.sh; \
    fi

# Stage 2: Runtime image - lean and efficient
FROM minizinc/mznc2026:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-25-jre-headless \
    python3 \
    vim \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /choco /choco
COPY --from=builder /root/.minizinc /root/.minizinc
