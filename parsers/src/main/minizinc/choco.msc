{
  "id": "org.choco.choco",
  "name": "Choco-solver",
  "description": "Choco FlatZinc executable",
  "version": "6.0.2",
  "mznlib": "mzn_lib/",
  "executable": "fzn-choco.sh",
  "tags": ["cp","int"],
  "stdFlags": ["-a","-f","-n","-p","-r","-s","-t","-v","--cp-profiler"],
  "extraFlags": [
    ["-lcg", "Use LCG", "bool", "false"],
    ["-lr", "Use a linear relaxation, solved with the given backend (OJALGO or OJALGO_EBM)", "string", ""]
  ],
  "supportsMzn": false,
  "supportsFzn": true,
  "needsSolns2Out": true,
  "needsMznExecutable": false,
  "needsStdlibDir": false,
  "isGUIApplication": false
}
