#!/bin/sh

TIME_LIMIT=500
MEM_LIMIT=4000
LVL="COMPET"
# By default, look for the jar in the 'parsers/target' directory of the repository
DIR="$(dirname "$0")/../../../target"
TDIR=./
SEED=0
# Can be set by the environment, otherwise the most recent light jar in DIR is used
CHOCO_JAR=${CHOCO_JAR:-}
usage="\

Usage: xcsp3_choco.sh [<options>] [<file>]

    Parse and solve <file> using Choco.

OPTIONS:

    -h, --help
        Display this message.

    -a
        This causes the solver to search for, and output all solutions.
        When this option is not given the solver should search for, and output the first solution or the best known one.

    -dir <s>
        Stands for the directory where the jar file resides.
        The default is the 'parsers/target' directory of the repository.

    -tl <n>
        Stands for the maximum CPU time given to solver (in seconds).
        The default is ${TIME_LIMIT}.

    -p  <n>
        Stands for the number of processing units allocated to the solver.
        The default is ${NB_NODES}.

    -ml <n>
        Stands for the maximum memory that the solver may use (in MiB).
        The default is ${MEM_LIMIT}.

    -tdir <s>
        Ignored for now.
        The directory where the solver is allowed to create temporary files.
        The default is ${TDIR}.

    -seed <n>
        Ignored for now.
        Stands for a random seed to be used by the solver.
        The default is ${SEED}.

    -jar <j>
        Override the jar file.  (The default is $CHOCO_JAR if set,
        otherwise the most recent choco-solver-*-light.jar in the -dir directory.)

    --jargs <args>
		Override default java argument (\"-Xss64m -Xms64m -Xmx4096m -server\")

EXAMPLES:

	Basic command to solve a fzn model with choco:
	$> ./xcsp3-exec alpha.xml


	Additionnal arguments:
	$> ./xcsp3-exec -a -tl 100 -p 2 ./alpha.xml

"

if test $# -eq 0
then
    echo "%% No XCSP file found"
    exit 1
fi

ARGS=""

while test $# -gt 0
do
    case "$1" in

        -h|--help)
            echo "$usage"
            exit 0
        ;;

        -a)
            ARGS="$ARGS -a"
        ;;

        -dir)
            DIR="$2"
            shift
        ;;

        -tl)
            TIME_LIMIT="$2"
            shift
        ;;

        -p)
            ARGS="$ARGS -p $2"
            shift
        ;;

        -ml)
            MEM_LIMIT="$2"
            shift
        ;;

        -tdir)
            TDIR="$2"
            shift
        ;;

        -seed)
            SEED="$2"
            shift
        ;;

        -jar)
            CHOCO_JAR="$2"
            shift
        ;;

    	--jargs)
            JAVA_ARGS="$2"
            shift
        ;;

        -*)
            echo "$0: unknown option \`$1'" 1>&2
            echo "$usage" 1>&2
            exit 2
        ;;

        *)
           break
        ;;

    esac
    shift
done

FILE="$1"

if test -z "${CHOCO_JAR}"
then
    CHOCO_JAR=$(ls -t "${DIR}"/choco-solver-*-light.jar 2>/dev/null | head -n 1)
fi
if test ! -f "${CHOCO_JAR}"
then
    echo "%% Choco jar file not found, build it with 'mvn package -DskipTests' or use -jar" 1>&2
    exit 1
fi

ARGS="$ARGS -limit=[${TIME_LIMIT}s] "

CMD="java -XX:+UseSerialGC -server -Xss128M -Xmx${MEM_LIMIT}m -cp \".:${CHOCO_JAR}\" org.chocosolver.parser.xcsp.ChocoXCSP \"${FILE}\" ${ARGS}"

eval ${CMD}

